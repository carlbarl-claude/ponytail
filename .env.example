# Copy this file to `.env` and fill in your real values, then load it before
# running the bot (e.g. `export $(grep -v '^#' .env | xargs)` on macOS/Linux),
# or set these as real environment variables. Never commit your real .env.

# Your Discord bot token — from https://discord.com/developers/applications
#   (your app -> Bot -> Reset Token). Keep this secret.
DISCORD_TOKEN=your-discord-bot-token-here

# Your Anthropic API key — from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use. Defaults to claude-opus-5 (best quality).
# Set to claude-sonnet-5 to roughly halve cost for high message volume.
# TUTOR_MODEL=claude-sonnet-5
